#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// ノブの短いタップでもスクロールが発生するよう、加速を無効にする。
&msc {
    time-to-max-speed-ms = <0>;
};

/ {
    behaviors {
        scroll_encoder: scroll_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            // 16msの更新周期を超え、1回転イベントで約1段スクロールする。
            tap-ms = <20>;
            bindings = <&msc MOVE_Y(-100)>, <&msc MOVE_Y(100)>;
        };
    };

    macros {
        ctrl_semicolon: ctrl_semicolon {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SEMI)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            display-name = "Base";

            bindings = <
                &kp TAB              &kp Q                &kp W                &kp E                &kp R                &kp T                   &kp Y                &kp U                &kp I                &kp O                &kp P                &kp ESC
                &kp LCTRL            &kp A                &kp S                &kp D                &kp F                &kp G                   &kp H                &kp J                &kp K                &kp L                &kp BSLH             &kp BSPC
                &kp LSHFT            &kp Z                &kp X                &kp C                &kp V                &kp B                &kp F13                 &mo 9                &kp N                &kp M                &kp COMMA            &kp DOT              &kp FSLH             &kp RALT
                &none                &none                &none                &mo 3                &kp LGUI             &kp RET                 &kp SPACE            &mo 1                &mo 2                &mo 5                &none                &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>, <&scroll_encoder>;
        };

        layer_1 {
            display-name = "Symbols";

            bindings = <
                &trans               &kp N1               &kp N2               &kp N3               &kp N4               &kp N5                  &kp N6               &kp N7               &kp N8               &kp N9               &kp N0               &kp NON_US_BSLH
                &trans               &kp FSLH             &kp COMMA            &kp LBKT             &kp SEMI             &kp MINUS               &kp EQUAL            &kp SQT              &kp RBKT             &kp DOT              &kp BSLH             &kp LS(NON_US_BSLH)
                &trans               &kp LS(N1)           &kp LS(N2)           &kp LS(N3)           &kp LS(N4)           &kp LS(N5)           &kp C_MUTE              &mkp MCLK            &kp LS(N6)           &kp LS(N7)           &kp LS(N8)           &kp LS(N9)           &kp LS(N0)           &trans
                &trans               &trans               &trans               &trans               &trans               &trans                  &trans               &trans               &trans               &trans               &trans               &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>, <&scroll_encoder>;
        };

        layer_2 {
            display-name = "Function";

            bindings = <
                &kp F1               &kp F2               &kp F3               &kp F4               &kp F5               &kp F6                  &kp F7               &kp F8               &kp F9               &kp F10              &kp F11              &kp F12
                &none                &kp S                &none                &none                &none                &none                   &kp LEFT             &kp DOWN             &kp UP               &kp RIGHT            &none                &none
                &none                &none                &none                &none                &kp V                &none                &kp C_MUTE              &mkp MCLK            &none                &none                &none                &none                &none                &none
                &none                &none                &none                &ctrl_semicolon      &none                &none                   &none                &none                &none                &none                &none                &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>, <&scroll_encoder>;
        };

        layer_3 {
            display-name = "Navigation";

            bindings = <
                &kp F1               &kp F2               &kp F3               &kp F4               &kp F5               &kp F6                  &kp F7               &kp F8               &kp F9               &kp F10              &kp F11              &kp F12
                &trans               &trans               &trans               &trans               &trans               &trans                  &kp LEFT             &kp DOWN             &kp UP               &kp RIGHT            &trans               &trans
                &trans               &trans               &trans               &trans               &trans               &trans               &trans                  &trans               &trans               &trans               &trans               &trans               &trans               &trans
                &trans               &trans               &trans               &trans               &trans               &trans                  &kp RALT             &kp RGUI             &kp RCTRL            &trans               &trans               &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>, <&scroll_encoder>;
        };

        layer_4 {
            display-name = "Unused 4";

            bindings = <
                &none                &none                &none                &none                &none                &none                   &none                &none                &none                &none                &none                &none
                &none                &none                &none                &none                &none                &none                   &none                &none                &none                &none                &none                &none
                &none                &none                &none                &none                &none                &none                &kp C_MUTE              &mkp MCLK            &none                &none                &none                &none                &none                &none
                &none                &none                &none                &none                &none                &none                   &none                &none                &none                &none                &none                &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>, <&scroll_encoder>;
        };

        layer_5 {
            display-name = "Numpad";

            bindings = <
                &none                &none                &none                &none                &none                &none                   &none                &kp KP_SLASH         &kp KP_PLUS          &kp KP_N7            &kp KP_N8            &kp KP_N9
                &none                &none                &none                &none                &none                &none                   &none                &kp KP_ASTERISK      &kp KP_COMMA         &kp KP_N4            &kp KP_N5            &kp KP_N6
                &none                &none                &none                &none                &none                &none                &kp C_MUTE              &mkp MCLK            &none                &kp KP_MINUS         &kp KP_EQUAL         &kp KP_N1            &kp KP_N2            &kp KP_N3
                &none                &none                &none                &none                &none                &none                   &none                &none                &kp KP_ENTER         &trans               &kp KP_N0            &kp KP_DOT
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>, <&scroll_encoder>;
        };

        layer_6 {
            display-name = "Unused 6";

            bindings = <
                &none                &none                &none                &none                &none                &none                   &none                &none                &none                &none                &none                &none
                &none                &none                &none                &none                &none                &none                   &none                &none                &none                &none                &none                &none
                &none                &none                &none                &none                &none                &none                &kp C_MUTE              &mkp MCLK            &none                &none                &none                &none                &none                &none
                &none                &none                &none                &none                &none                &none                   &none                &none                &none                &none                &none                &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>, <&scroll_encoder>;
        };

        layer_7 {
            display-name = "Unused 7";

            bindings = <
                &none                &none                &none                &none                &none                &none                   &none                &none                &none                &none                &none                &none
                &none                &none                &none                &none                &none                &none                   &none                &none                &none                &none                &none                &none
                &none                &none                &none                &none                &none                &none                &kp C_MUTE              &mkp MCLK            &none                &none                &none                &none                &none                &none
                &none                &none                &none                &none                &none                &none                   &none                &none                &none                &none                &none                &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>, <&scroll_encoder>;
        };

        layer_8 {
            display-name = "Unused 8";

            bindings = <
                &none                &none                &none                &none                &none                &none                   &none                &none                &none                &none                &none                &none
                &none                &none                &none                &none                &none                &none                   &none                &none                &none                &none                &none                &none
                &none                &none                &none                &none                &none                &none                &kp C_MUTE              &mkp MCLK            &none                &none                &none                &none                &none                &none
                &none                &none                &none                &none                &none                &none                   &none                &none                &none                &none                &none                &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>, <&scroll_encoder>;
        };

        layer_9 {
            display-name = "Bluetooth";

            // 右ノブを押しながらTabでStudioのロックを解除する。
            bindings = <
                &studio_unlock       &none                &none                &none                &none                &none                   &none                &none                &none                &none                &none                &none
                &bt BT_SEL 0         &none                &none                &none                &none                &none                   &none                &none                &none                &none                &none                &none
                &bt BT_SEL 1         &none                &none                &none                &none                &none                &kp C_MUTE              &mkp MCLK            &none                &none                &none                &none                &none                &none
                &bt BT_SEL 2         &none                &none                &none                &none                &none                   &none                &none                &none                &none                &none                &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>, <&scroll_encoder>;
        };
    };
};
